graph {
    // Suppression de fixedsize pour ne pas écraser l'image + ajout de imagescale
    node [image="icon_router.png", imagescale=true, shape="none", width="0.8", height="0.8", fontcolor="red", fontsize="14pt", labelloc="b"];
    
    edge [fontcolor="blue", fontsize="14pt"];

    A; B; C; D; E; F; G; H;

    A -- B [label="1"];
    A -- C [label="4"];
    B -- C [label="2"];
    B -- D [label="9"];
    B -- G [label="4"];
    B -- H [label="2"];
    C -- D [label="4"];
    C -- E [label="3"];
    D -- E [label="1"];
    D -- F [label="3"];
    D -- G [label="1"];
    E -- F [label="1"];
    F -- G [label="6"];
    G -- H [label="14"];
}
