graph {
    // Style global pour les nœuds avec l'icône
    node [image="icon_router.png", shape="none", width="0.6", height="0.6", fixedsize=true, fontcolor="red", fontsize="14pt", labelloc="b"];
    
    // Style global pour les arcs
    edge [fontcolor="blue", fontsize="14pt"];

    // Nœuds
    A; B; C; D; E; F; G; H;

    // Liens et poids
    A -- B [label="1"];
    A -- C [label="4"];
    B -- C [label="2"];
    B -- D [label="9"];
    B -- G [label="4"];
    B -- H [label="2"];
    C -- D [label="4"];
    C -- E [label="3"];
    D -- E [label="1"];
    D -- F [label="3"];
    D -- G [label="1"];
    E -- F [label="1"];
    F -- G [label="6"];
    G -- H [label="14"];
}
